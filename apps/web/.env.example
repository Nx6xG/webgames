# WebSocket server URL.
# Local dev: leave empty — the app derives http://<hostname>:3001 from window.location.
# Production (Vercel): set to your Render service URL, e.g. https://webgames-ws.onrender.com
NEXT_PUBLIC_WS_URL=

# Supabase (optional — leave empty to disable auth + cloud sync)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
