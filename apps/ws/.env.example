# Port the WS server listens on.
# Render sets this automatically. Local dev default: 3001.
PORT=3001

# CORS origin for the Socket.IO server.
# Comma-separated for multiple origins. localhost:3000 is always allowed automatically.
# Production (Render): set to your domain, e.g. https://games.nico-grim.me
# To allow all origins (quick/unsafe): *
WS_CORS_ORIGIN=http://localhost:3000
